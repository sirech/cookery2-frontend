{
  "name": "cookery2",
  "version": "0.0.1",
  "private": false,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"**/*.+(ts|tsx|json|css|scss)\"",
    "linter:js": "npx eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "linter:css": "npx stylelint 'src/**/*.css'",
    "watch": "vitest",
    "bundle": "npm run build && source-map-explorer 'dist/assets/*.js'",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.11.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "axios": "^1.13.2",
    "formik": "^2.4.9",
    "formik-mui": "^4.0.0",
    "ramda": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "react-use": "^17.6.0",
    "typescript": "5.9.3",
    "yup": "^1.7.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-recommended"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^17.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.3",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "coveralls": "^3.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react": "^1.1.7",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.15.4",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.1.1",
    "source-map-explorer": "^2.5.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0",
    "*.scss": "./go linter-css"
  }
}
